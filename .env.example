# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Airtable personal access token. Required scopes:
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
# and access to the WEP base.
AIRTABLE_TOKEN=

# Airtable base ID (starts with "app")
AIRTABLE_BASE_ID=appBTvrLNv8i0QLkX

# Optional: the table that stores registrations. Use the table ID (starts with "tbl")
# so renaming the table in Airtable does not break the form. Defaults to the table named "BCG WEP".
AIRTABLE_TABLE_ID=

# Password for the results dashboard at /dashboard
DASHBOARD_PASSWORD=

# Optional: random string used to sign dashboard sessions (e.g. 32+ random characters).
# If omitted, one is derived from the password and token.
SESSION_SECRET=
